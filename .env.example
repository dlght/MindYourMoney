EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Optional (F5) — no-ops until set, see specs/005-server-push-hardening/research.md #5/#6
EXPO_PUBLIC_SENTRY_DSN=
# Public half of the VAPID key pair used for Web Push (F8) — not sensitive,
# safe to ship to every client. Generate the pair once with
# `npx web-push generate-vapid-keys`; the private half is a Supabase Edge
# Function secret (VAPID_PRIVATE_KEY), never an env var here.
# See specs/008-web-push-notifications/research.md #2.
EXPO_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
