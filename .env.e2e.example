# Copy to .env.e2e (gitignored) and fill in real values before running
# `npm run test:e2e`. This account must be a dedicated Supabase Auth user
# reserved for automated testing — never a real user's credentials.
# See specs/006-pwa-e2e-layout-fix/quickstart.md for setup steps.

E2E_TEST_EMAIL=e2e-test@example.com
E2E_TEST_PASSWORD=replace-with-a-real-test-account-password

# Optional: point the suite at a deployed site (e.g. the Netlify PWA)
# instead of building/serving a local dist/ export.
# E2E_BASE_URL=https://your-app.netlify.app
